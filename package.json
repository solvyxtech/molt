{
  "name": "molt-desktop",
  "version": "0.1.0",
  "description": "molt, with a window. A coding agent that can't say done without proving it.",
  "keywords": [
    "ai",
    "agent",
    "cli",
    "coding-agent",
    "llm",
    "local-first",
    "ollama",
    "verification",
    "tui"
  ],
  "license": "MIT",
  "author": "Tyler Skelton",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "main": "out/main.cjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').chmodSync('dist/cli.js', 0o755)\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.app.json --noEmit",
    "test": "npm run build && node test-run.mjs",
    "test:build": "rm -rf dist-test && tsc -p tsconfig.test.json",
    "pretest": "npm run test:build",
    "check": "npm run typecheck && npm test && npm run e2e && npm run self-check",
    "start": "node dist/cli.js",
    "app": "npm run bundle && electron out/main.cjs",
    "bundle": "node build.mjs",
    "bundle:dev": "node build.mjs --dev",
    "dev": "npm run bundle:dev && electron out/main.cjs",
    "pack": "npm run bundle && electron-builder --dir",
    "dist:mac": "npm run bundle && electron-builder --mac",
    "dist:win": "npm run bundle && electron-builder --win",
    "dist:linux": "npm run bundle && electron-builder --linux",
    "e2e": "npm run bundle && MOLT_E2E_VIA_UI=1 node test-e2e/drive.mjs",
    "self-check": "npm run bundle && electron out/main.cjs --self-check",
    "app:install": "npm run bundle && electron-builder --dir && node install.mjs",
    "app:push": "npm run bundle && node install.mjs --push",
    "e2e:direct": "npm run bundle && node test-e2e/drive.mjs"
  },
  "dependencies": {
    "ink": "^5.0.1",
    "react": "^18.3.1",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  },
  "private": true
}
