{
  "name": "@solvyx/molt",
  "version": "0.9.0",
  "description": "A coding agent that can't say \"done\" without proving it.",
  "keywords": [
    "ai",
    "agent",
    "cli",
    "coding-agent",
    "llm",
    "local-first",
    "ollama",
    "verification",
    "tui"
  ],
  "license": "MIT",
  "author": "Tyler Skelton",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solvyxtech/molt.git"
  },
  "bugs": {
    "url": "https://github.com/solvyxtech/molt/issues"
  },
  "homepage": "https://github.com/solvyxtech/molt#readme",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "molt": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').chmodSync('dist/cli.js', 0o755)\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist-test/test/*.test.js",
    "test:build": "tsc -p tsconfig.test.json",
    "pretest": "npm run test:build",
    "check": "npm run typecheck && npm test",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "ink": "^5.0.1",
    "react": "^18.3.1",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "typescript": "^5.6.2"
  }
}
